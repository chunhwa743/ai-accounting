# Copy to .env. Only the first value is genuinely required.
#
# Every other setting has a working default in src/aiacct/config.py, so a
# machine that matches them needs nothing here at all. Add a line only to
# change something.

# ---- Required ----
OPENAI_API_KEY=sk-...

# ---- Required only if Postgres is not at this default ----
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aiacct

# ---- Required anywhere but a local machine ----
# Signs access tokens. Anyone holding this can mint a token for any user.
# Must be at least 32 bytes.
# JWT_SECRET=

# ---- Everything below is optional ----
#
# Shown so you know it exists, not because it needs setting. See
# src/aiacct/config.py for the full list and what each one does.
#
# SEED_PASSWORD=aiacct-demo-2026   # given to every seeded user; see README
# ACCESS_TOKEN_MINUTES=720         # a working day
# MODEL_PRIMARY=gpt-5.6-luna
# USE_STUB_LLM=false               # true runs everything offline, with no API key
# TEST_DATABASE_URL=               # defaults to DATABASE_URL with _test appended
